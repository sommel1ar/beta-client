{
  "XRay": {
    "states": ["Blending"],

     "vertexShader": "shaders/xray.vertex",
     "fragmentShader": "shaders/xray.fragment"
  },
  "Waypoints": {
    "states": ["Blending"],

     "vertexShader": "shaders/color.vertex",
     "fragmentShader": "shaders/color.fragment"
  },
  "Minimap": {
    "states": [
      "EnableStencilTest",
      "DisableDepthTest",
      "Blending"
    ],

     "vertexShader": "shaders/minimap.vertex",
     "fragmentShader": "shaders/minimap.fragment"
  },
  "OpaqueUI": {
    "states": [
      "EnableStencilTest",
      "DisableDepthTest"
    ],

    "frontFace": {
      "stencilFunc": "Equal",
      "stencilFailOp": "Keep",
      "stencilDepthFailOp": "Keep",
      "stencilPassOp": "Keep"
    },

    "backFace": {
      "stencilFunc": "Equal",
      "stencilFailOp": "Keep",
      "stencilDepthFailOp": "Keep",
      "stencilPassOp": "Keep"
    },

    "vertexShader": "shaders/color_uv.vertex",
    "fragmentShader": "shaders/color_texture.fragment"
  }
}
