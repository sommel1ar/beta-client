    <string name="error_minecraft_assets_unavailable">"Niedostępne zasoby Minecraft'a"</string>
    <string name="error_minecraft_assets_unavailable_desc">"Nie można załadować domyślnych zasobów Minecraft'a: PE, które są potrzebne tej aplikacji. Proszę wybrać plik .apk twojej aktualnej wersji Minecraft albo skopiować je za pomocą roota."</string>
    <string name="error_minecraft_major_update">"Nieobsługiwana wersja Minecraft'a"</string>
    <string name="error_minecraft_major_update_desc">"Nieobsługiwana wersja Minecraft'a: Pocket Edition jest zainstalowana na tym urządzeniu. Proszę sprawdzić aktualizacje dla launchera. Proszę jednak pamiętać, że może to potrwać kilka dni nim zostanie opublikowana zaktualizowana wersja launchera."</string>
    <string name="error_minecraft_not_installed">Minecraft nie jest zainstalowany</string>
    <string name="error_minecraft_not_installed_desc">Minecraft: Pocket Edition nie jest zainstalowany na tym urządzeniu. Musisz posiadać Minecraft: Pocket Edition, aby móc korzystać z tego Launchera. Proszę zakupić i pobrać go za pomocą Sklepu Play.</string>
    <string name="error_minecraft_outdated">"Zbyt stara wersja Minecraft'a"</string>
    <string name="error_minecraft_outdated_desc">"Zbyt stara wersja Minecraft'a: Pocket Edition jest zainstalowana na tym urządzeniu. Możesz zaktualizować ją za pomocą sklepu Google Play."</string>
    <string name="error_minecraft_unsupported">"Nieobsługiwana wersja Minecraft'a"</string>
    <string name="error_minecraft_unsupported_arm_on_intel">"Nieobsługiwana wersja Minecraft'a"</string>
    <string name="error_minecraft_unsupported_arm_on_intel_desc">"Nieobsługiwana wersja Minecraft'a: Pocket Edition jest zainstalowana na tym urządzeniu - wersja dla procesorów ARM zamiast x86. Proszę pobrać MCPE ze sklepu Google Play zamiast z innych źródeł."</string>
    <string name="error_minecraft_unsupported_desc">"Nieobsługiwana wersja Minecraft'a: Pocket Edition jest zainstalowana na tym urządzeniu (%1$s - %2$s). Launcher może nie działać prawidłowo i może powodować błędy. "<b>Kontynuujesz na własne ryzyko!</b></string>
    <string name="error_no_bl_perm">"Dodatek do BlockLauncher'a"</string>
    <string name="error_no_bl_perm_desc">Aby móc skorzystać z tego dodatku w programie BlockLauncher musisz zaakceptować to uprawnienie.</string>
    <string name="error_no_storage_access">Brak uprawnienia do zapisu na zewnętrznej pamięci</string>
    <string name="error_no_storage_access_desc">Aby użyć tej aplikacji, musisz zezwolić jej na dostęp do zewnętrznej pamięci (aby móc zapisywać i odczytywać światy w grze). Jeżeli zaznaczyłeś \"Nie pytaj ponownie\" będziesz musiał przejść do ustawień i włączyć to uprawnienie tam.</string>
    <string name="error_unknown">Coś poszło nie tak</string>
    <string name="error_unknown_desc">Nie wiemy co się stało, ale coś poszło nie tak. Prosimy spróbować ponownie.</string>
